#include "sql_task_queue.h"
#include "sqlite3.h"

#include <stddef.h>
#include <stdbool.h>
#include <stdio.h>

#define NUM_POSSIBLE_SQL_STATEMENTS {{ NUM_DATA_PACKET_TYPES }}

sqlite3_stmt *compiled_sql_statements[NUM_POSSIBLE_SQL_STATEMENTS];

uint8_t execute_task(const Task* task) {

}

bool initialize_database_executer(sqlite3 *db) {
    int result;
    {% for prepare_statement_command, str_len in sql_prepared_statement_commands.items() %}
    result = sqlite3_prepare_v2(db, "{{ prepare_statement_command }}", {{str_len}}, &(compiled_sql_statements[{{ loop.index0 }}]), NULL);

    if (result != SQLITE_OK) {
        printf("COMPILING PREPARED STATEMENT {{ loop.index0 }} FAILED WITH SQL ERROR CODE %d", result);
        return false;
    }
    {% endfor %}

    return true;
}

void finalize_database_executer() {
    for (int i = 0; i < NUM_POSSIBLE_SQL_STATEMENTS; i++) {
        sqlite3_finalize(compiled_sql_statements[i]);
    }
}

{% for data_packet_name, data_packet_items in DATA_PACKETS.items() %}
/**
 * Non-blocking method which attempts to add a task to the global sql task queue.
 * This task will add the specified {{data_packet_name}} to the sql database.
 * Returns false if the queue is full, or true if the operation was successful.
 * This method is thread-safe and non-blocking
 */
bool try_enqueue_{{data_packet_name.lower_snake_case}} (
{%- for param_name, param_type in data_packet_items.items() %}
    {{ param_type.c }} {{param_name.lower_snake_case}}{% if loop.index < (data_packet_items | length) %}, {% endif -%}
{%- endfor %}
) {
    struct SQL_TASK_{{data_packet_name.upper_snake_case}} task;
{%- for param_name, param_type in data_packet_items.items %}
    task.item_{{loop.index0}} = {{param_name.lower_snake_case}};
{%- endfor %}
}