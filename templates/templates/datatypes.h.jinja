#ifndef DATATYPES_H
#define DATATYPES_H

#include <cstdint>
#include <cstddef>
#include <array>
#include <atomic>

#include "sqlite3.h"

enum class DataPacketType {
    {% for data_packet in all_data_packets%}
    {{data_packet.variable_name | upper}},
    {% endfor %}
};

{% for data_packet in all_data_packets %}
struct {{data_packet.title_name}} {
    {% for variable_type, variable_names in data_packet.variables_by_type.items() %}
    {{variable_type}} {{variable_names | join(", ")}};
    {% endfor %}

    /** Default (empty) constructor */
    {{data_packet.title_name}}(): 
        {{ data_packet.variables | map("strformat", "{0[name]}({0[type].default_value})" ) | join(", ") }} { }

    {{data_packet.title_name}}(const std::byte (&raw_array)[{{data_packet.variables | map(attribute="type.size") | sum}}]); 
    {{data_packet.title_name}}({{ data_packet.variables | map("strformat", "{0[type].typename} _{0[name]}" )| join(", ") }}):
        {{ data_packet.variables | map(attribute="name") | map("strformat", "{0}(_{0})" ) | join(", ") }} { }
    {{data_packet.title_name}}(const {{data_packet.title_name}}&) = default;
};

{% endfor %}
struct DataEntry {
    DataPacketType type;
    union DataEntryUnionType {
        {% for data_packet in all_data_packets%}
        {{data_packet.title_name}} {{data_packet.variable_name}};
        {% endfor %}

        /** Default (empty) constructor */
        DataEntryUnionType() { }
        {% for data_packet in all_data_packets%}
        DataEntryUnionType({{data_packet.title_name}} _{{data_packet.variable_name}}): {{data_packet.variable_name}}(_{{data_packet.variable_name}}) { }
        {% endfor %}
    } data;

    /** Default (empty) constructor */
    DataEntry() { }

    /** Copy constructor */
    DataEntry(const DataEntry& other) noexcept(true);
    {% for data_packet in all_data_packets %}

    /** Constructor for DataEntry that initializes to hold a {{data_packet.title_name}} */
    DataEntry({{data_packet.title_name}} _{{data_packet.variable_name}}): 
        type(DataPacketType::{{data_packet.variable_name | upper}}), data(_{{data_packet.variable_name}}) { }
    {% endfor %}
};

struct DataCollection {
    {% for data_packet in all_data_packets%}
    std::atomic<{{data_packet.title_name}}> {{data_packet.variable_name}};
    {% endfor %}

    /** Default (empty) constructor */
    DataCollection():
        {{ all_data_packets | map("strformat", "{0[variable_name]}({0[title_name]}())") | join(",\n\t\t")}}
    { }

    /** Copy constructor */
    DataCollection(const DataCollection& other) = delete;

    template<typename T> T load();
    void store(const DataEntry& data);
};

#endif